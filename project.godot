; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ultimate-Tic-Tac-Toe"
run/main_scene="res://scene/ultimate_tic_tac_toe_game.tscn"
config/features=PackedStringArray("4.2", "Mobile")
boot_splash/bg_color=Color(0.87451, 0.439216, 0.14902, 1)
boot_splash/image="res://icon.png"
boot_splash/use_filter=false
config/icon="res://icon.png"

[autoload]

Global="*res://script/global.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/mode=3
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.87451, 0.439216, 0.14902, 1)
